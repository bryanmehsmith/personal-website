{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:coverage:*)",
      "Bash(npm run build:*)",
      "Bash(npm start:*)",
      "Bash(npm install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-generated-paths.js"
          }
        ]
      }
    ]
  }
}
